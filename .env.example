# Database (PostgreSQL — bisa pakai Supabase, Neon, Railway, dll)
# Jika pakai Supabase: DATABASE_URL = pooler connection (port 6543, ?pgbouncer=true)
#                       DIRECT_URL  = direct connection (port 5432), dipakai khusus saat migration
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # generate dengan: openssl rand -base64 32

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# AI Provider — pilih "anthropic" atau "gemini". Default: anthropic
# Gemini punya free tier (cek ai.google.dev), cocok untuk development tanpa biaya.
AI_PROVIDER="gemini"

# Anthropic (Claude AI) — wajib diisi jika AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=""

# Google Gemini — wajib diisi jika AI_PROVIDER=gemini
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Email (Resend) — dipakai untuk kirim link reset password.
# Kalau dikosongkan, link reset cuma di-log ke console server (mode dev).
# Daftar gratis di: https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="StockAI <onboarding@resend.dev>"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_MONTHLY=""
STRIPE_STARTER_YEARLY=""
STRIPE_PRO_MONTHLY=""
STRIPE_PRO_YEARLY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
